# Copy to .env and fill in values:  cp .env.example .env
# NAMES ONLY. Never commit real values (R17). Every new variable is added here first (R12).
# Vendors: ADR-0006 (Gemini + Sarvam primary). Hosting: ADR-0002 (Supabase).

# ── App ──────────────────────────────────────────────────────────────
ENV=
APP_VERSION=
LOG_LEVEL=
# JSON list, e.g. ["http://localhost:5173"]
CORS_ALLOWED_ORIGINS=

# ── Database / Redis ─────────────────────────────────────────────────
# Local Docker only (postgres init script + container URLs in infra/docker-compose.yml)
POSTGRES_OWNER_PASSWORD=
APP_DB_PASSWORD=
# DATABASE_URL           -> saathi_app role (NOBYPASSRLS, RLS applies)       (R24)
# MIGRATION_DATABASE_URL -> schema-owner role, migrations only
# Supabase: use the SESSION pooler (port 5432) or the direct connection, not the transaction
# pooler (6543), which breaks asyncpg prepared statements. Format:
#   postgresql+asyncpg://saathi_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
MIGRATION_DATABASE_URL=
REDIS_URL=

# ── Auth (verified JWT; tenant comes from the token, R8) ─────────────
# Supabase Auth: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
AUTH_JWKS_URL=
# Supabase Auth: https://<project-ref>.supabase.co/auth/v1
AUTH_ISSUER=
# Supabase Auth: authenticated
AUTH_AUDIENCE=

# ── Platform-wide provider choice (registry keys) ────────────────────
EMBEDDING_PROVIDER=
RERANKER_PROVIDER=
STT_PROVIDER=
TTS_PROVIDER=
STORAGE_PROVIDER=

# ── Model catalog (which models tenants can pick; empty = not offered) ─
# Gemini owns "standard" / "advanced"; Anthropic is offered as "claude-standard" / "claude-advanced"
# e.g. a Flash model (standard) and the flagship model (advanced); `make check-keys` lists ids
GEMINI_MODEL_SMALL=
GEMINI_MODEL_LARGE=
ANTHROPIC_MODEL_SMALL=
ANTHROPIC_MODEL_LARGE=

# ── Google Gemini (LLM + embeddings) ─────────────────────────────────
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_TIMEOUT_SECONDS=
# R13: fixed before the first ingestion; changing it means re-indexing everything
GEMINI_EMBEDDING_MODEL=
GEMINI_EMBEDDING_DIMENSIONS=
GEMINI_EMBEDDING_TIMEOUT_SECONDS=

# ── Sarvam AI (speech-to-text, text-to-speech, translate) ────────────
SARVAM_API_KEY=
SARVAM_BASE_URL=
SARVAM_STT_MODEL=
# transcribe | translate | verbatim | translit | codemix
SARVAM_STT_MODE=
SARVAM_TTS_MODEL=
# Used for languages the main TTS model can't speak (bulbul:v4-flash: Malayalam, Odia)
SARVAM_TTS_FALLBACK_MODEL=
# Empty = the TTS model's default voice. bulbul:v4-flash ids look like simran_hi_conversation
SARVAM_TTS_SPEAKER=
SARVAM_TTS_MAX_CHARS=
SARVAM_TIMEOUT_SECONDS=

# ── Other AI providers (optional / fallback) ─────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_TIMEOUT_SECONDS=

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=

COHERE_API_KEY=
COHERE_RERANK_MODEL=
COHERE_BASE_URL=
COHERE_TIMEOUT_SECONDS=

# ── Supabase (project, storage) ──────────────────────────────────────
# https://<project-ref>.supabase.co
SUPABASE_URL=
# Public key: browser / Studio auth SDK only
SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses Storage RLS; never send to a browser (R17)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_PRIVATE_BUCKET=
SUPABASE_STORAGE_PUBLIC_BUCKET=
SUPABASE_STORAGE_TIMEOUT_SECONDS=

# ── Other hosted services ────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Tenant credential encryption (AES-256-GCM) ───────────────────────
# Format: "k1:<base64 32 bytes>[,k0:<older key>]"  (first = current)
CREDENTIALS_ENCRYPTION_KEYS=

# ── WhatsApp Cloud API ───────────────────────────────────────────────
WHATSAPP_GRAPH_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Only for: make check-keys ARGS=--send-whatsapp
WHATSAPP_TEST_RECIPIENT=

# ── n8n (optional profile) ───────────────────────────────────────────
N8N_ENCRYPTION_KEY=
