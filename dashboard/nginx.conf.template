# Bot Studio static server, inside the saathi-studio container (ADR-0008).
# Traefik terminates HTTPS in front of it; this only serves files on :8080 (non-root nginx).
# ${SAATHI_BASE_DOMAIN} is filled in at container start (official nginx image envsubst);
# nginx's own $variables are left untouched.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Hashed build assets never change: cache for a year.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Single-page app: unknown paths load index.html (never cached, so releases show up at once).
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        # Only our own scripts/styles; network calls only to our API and Supabase (login, P5.9).
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://api.${SAATHI_BASE_DOMAIN} https://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
        try_files $uri $uri/ /index.html;
    }
}
