# nginx site for the VPS (ADR-0008). Rendered by scripts/vps/setup.sh: __DOMAIN__ -> your domain,
# installed as /etc/nginx/sites-available/saathi.conf. certbot then adds the HTTPS (443) blocks
# and the HTTP -> HTTPS redirects. Don't edit the copy on the server by hand: change this
# template, commit, and re-run setup.sh.
#
# nginx is the edge, so it OVERWRITES forwarding headers instead of trusting the client's
# (uvicorn trusts them only from the Docker gateway, FORWARDED_ALLOW_IPS).

limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=conn_per_ip:10m;

upstream saathi_api {
    server 127.0.0.1:8000;
    keepalive 32;
}

# --------------------------------------------------------------------------------- API
server {
    listen 80;
    listen [::]:80;
    server_name api.__DOMAIN__;

    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 25m;          # document uploads
    client_body_timeout 30s;
    limit_conn conn_per_ip 50;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    location / {
        limit_req zone=api_per_ip burst=40 nodelay;
        limit_req_status 429;
        proxy_read_timeout 60s;
        proxy_pass http://saathi_api;
    }

    # SSE streaming (P3.8): no buffering, long read timeout.
    location /api/v1/chat/stream {
        limit_req zone=api_per_ip burst=10 nodelay;
        limit_req_status 429;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_pass http://saathi_api;
    }

    # Agent inbox WebSocket (Phase 5).
    location /api/v1/inbox/ws {
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_pass http://saathi_api;
    }
}

# ------------------------------------------------------------------------- Bot Studio (static)
server {
    listen 80;
    listen [::]:80;
    server_name app.__DOMAIN__;

    root /var/www/saathi-studio;       # published by the compose `studio` job on every release
    index index.html;

    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    # Only our own scripts/styles; network calls only to our API and Supabase (login, P5.9).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://api.__DOMAIN__ https://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

    # Hashed build assets never change: cache for a year.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Single-page app: unknown paths load index.html (never cached, so deploys show up at once).
    location / {
        add_header Cache-Control "no-cache" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://api.__DOMAIN__ https://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
        try_files $uri $uri/ /index.html;
    }
}
